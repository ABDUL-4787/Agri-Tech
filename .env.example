# AgriGrade Configuration Environment Variables

# Database Connection URL:
# Local Development: SQLite (auto-creates agrigrade.db in data/ directory)
DATABASE_URL=sqlite:///./data/agrigrade.db
# Neon PostgreSQL Production Deployment:
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Storage Provider Strategy:
# "local" for local disk storage (data/uploads, data/annotated)
# "memory" for stateless serverless deployment (Vercel Functions)
STORAGE_TYPE=local

# Public Base URL for Report QR Codes and Shared Links:
PUBLIC_BASE_URL=http://localhost:8000
# Production:
# PUBLIC_BASE_URL=https://agrigrade.vercel.app

# Optional Remote Computer Vision Grading Service:
# Set only if running a separate Docker/Render grading microservice:
# GRADING_API_URL=https://agrigrade-vision.onrender.com

# Optional ML Weights (Do not specify unless task-specific fine-tuned weights exist):
# YOLO_WEIGHTS_PATH=/path/to/tomato_yolo_seg.pt
# MOBILENET_WEIGHTS_PATH=/path/to/tomato_mobilenet_v3.pth
